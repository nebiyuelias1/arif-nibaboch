<% club ||= book_read.book_club %>
<% rsvp ||=
  (
    if user_signed_in?
      book_read.book_read_rsvps.find_by(user: current_user)
    else
      nil
    end
  ) %>
<% is_going = rsvp&.going? || rsvp&.waitlisted? %>
<% can_manage = can_manage_book_read?(club, book_read, current_user) %>
<% share_url = "#{request.base_url}#{book_club_book_read_path(club, book_read)}" %>

<%= turbo_frame_tag dom_id(book_read, :card_rsvp), class: "w-full" do %>
  <div
    class="
      card-actions justify-self-end w-full mt-4 flex items-center gap-2 relative z-20
    ">
    <div class="flex-1 min-w-0">
      <% if can_manage %>
        <%= link_to edit_book_club_book_read_path(club, book_read),
            class: "w-full btn btn-primary cursor-pointer text-center",
            data: { turbo_frame: "_top" } do %>
          <%= t("edit_read", default: "Edit Read") %>
        <% end %>
      <% elsif user_signed_in? %>
        <% if is_going %>
          <%= button_to book_club_book_read_rsvp_path(club, book_read),
              method: :patch,
              params: { book_read_rsvp: { status: :cancelled } },
              form: { onclick: "event.stopPropagation();", class: "w-full" },
              class: "w-full btn btn-outline cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed",
              data: { disable_with: t("updating_rsvp"), turbo_confirm: t("cancel_rsvp_confirm") } do %>
            <%= rsvp.waitlisted? ? t("waitlisted") : t("rsvpd") %>
          <% end %>
        <% else %>
          <%= button_to book_club_book_read_rsvp_path(club, book_read),
              method: :post,
              params: { book_read_rsvp: { status: :going } },
              form: { onclick: "event.stopPropagation();", class: "w-full" },
              class: "w-full btn btn-primary cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed",
              data: { disable_with: t("updating_rsvp") } do %>
            <%= t("rsvp", default: "RSVP") %>
          <% end %>
        <% end %>
      <% else %>
        <%= button_to new_user_session_path,
            method: :get,
            form: { onclick: "event.stopPropagation();", class: "w-full", data: { turbo_frame: "_top" } },
            class: "w-full btn btn-primary cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed text-center" do %>
          <%= t("rsvp", default: "RSVP") %>
        <% end %>
      <% end %>
    </div>

    <%# Share Button leveraging Stimulus share controller %>
    <button
      type="button"
      aria-label="<%= t("share", default: "Share") %>"
      data-controller="share"
      data-action="click->share#share:prevent:stop"
      data-share-url-value="<%= share_url %>"
      data-share-title-value="<%= book_read.book&.title || t("discussion_session", default: "Book Read") %>"
      onclick="event.preventDefault(); event.stopPropagation();"
      class="
        btn btn-square border border-border bg-surface text-content hover:bg-background
        hover:text-accent hover:border-accent cursor-pointer transition-colors shrink-0
      ">
      <span class="sr-only" data-share-target="label"><%= t("share", default: "Share") %></span>
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true">
        <path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7" />
        <path d="M16 6l-4-4-4 4" />
        <path d="M12 2v14" />
      </svg>
    </button>
  </div>
<% end %>
