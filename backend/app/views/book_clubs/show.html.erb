<% content_for :title, @club.name %>
<div
  data-controller="book-club"
  class="max-w-4xl mx-auto"
  data-book-club-club-id-value="<%= @club.id %>">
  <div class="bg-surface rounded-lg shadow-sm overflow-hidden mb-8">
    <% if @club.cover_photo.attached? %>
      <div class="h-64 w-full bg-background relative">
        <%= image_tag @club.cover_photo, class: "w-full h-full object-cover" %>
      </div>
    <% else %>
      <div
        class="
          h-48 w-full bg-primary flex items-center justify-center text-primary-contrast
        ">
        <svg
          class="w-16 h-16 opacity-50"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </div>
    <% end %>

    <div class="p-8">
      <% can_see_private = @club.private_info_visible_to?(current_user) %>

      <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0">
          <div class="flex items-center gap-3 mb-2">
            <% if @club.photo.attached? %>
              <%= image_tag @club.photo,
              alt: "",
              class:
                "w-10 h-10 aspect-square rounded-full object-cover ring-2 ring-accent/20 shrink-0" %>
            <% else %>
              <div
                aria-hidden="true"
                class="
                  w-10 h-10 rounded-full bg-accent/15 text-accent font-bold text-base flex
                  items-center justify-center shrink-0
                ">
                <%= @club.name_initial %>
              </div>
            <% end %>
            <h1 class="title title-lg text-content font-bold"><%= @club.name %></h1>
          </div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-6">
            <% if @club.is_private %>
              <span
                class="
                  badge badge-sm gap-1.5 font-medium bg-primary text-primary-contrast
                  border-primary
                ">
                Private Club
              </span>
            <% else %>
              <span
                class="
                  badge badge-sm gap-1.5 font-medium bg-accent/15 text-content border-accent/40
                ">
                Public Club
              </span>
            <% end %>
            <% if @club.owner %>
              <span class="inline-flex items-center gap-1.5 text-sm text-content-subtle">
                <%= render "shared/avatar",
                user: @club.owner,
                classes:
                  "w-6 h-6 ring-1 ring-border bg-primary text-primary-contrast text-[10px] font-semibold" %>
                <span>
                  Created by
                  <span class="font-medium text-content"><%= @club.owner.name.presence || @club.owner.username.presence || "Unknown User" %></span>
                </span>
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1.5 text-sm text-content-subtle">
                <span
                  aria-hidden="true"
                  class="
                    w-6 h-6 rounded-full bg-background text-content-muted text-[10px] font-semibold
                    flex items-center justify-center ring-1 ring-border
                  ">?</span>
                <span>Created by
                  <span class="font-medium">Deleted User</span></span>
              </span>
            <% end %>
          </div>

          <% if can_see_private %>
            <button
              onclick="document.getElementById('members_dialog').showModal()"
              class="
                text-left mt-4 hover:opacity-80 transition-opacity focus:outline-none
                focus:ring-2 focus:ring-offset-2 focus:ring-primary rounded-md block
              ">
              <div class="flex items-center gap-2">
                <%= render "shared/avatar_group",
                users: @club.members,
                limit: 5,
                size_classes: "w-6 h-6",
                text_size: "text-[9px]",
                container_classes: "cursor-pointer" %>
                <span class="text-sm text-content-subtle font-medium"><%= t("member_count", count: @club.members.count) %></span>
                <%# Owner-only pending requests indicator; kept in sync by the approve/reject turbo streams via [data-pending-requests-badge] %>
                <% if user_signed_in? && @club.owner == current_user %>
                  <span data-pending-requests-badge>
                    <%= render "book_clubs/pending_requests_badge", club: @club %>
                  </span>
                <% end %>
              </div>
            </button>
          <% end %>
        </div>

        <div
          id="book_club_show_join_button_container"
          class="w-full sm:w-auto shrink-0">
          <%= render "book_clubs/show_join_button", club: @club %>
        </div>
      </div>

      <div class="prose max-w-none text-content-subtle mt-6">
        <% if @club.description.present? %>
          <%= render "shared/collapsible_text", text: @club.description %>
        <% else %>
          <p class="italic text-content-muted">No description provided for this club yet.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="flex justify-between items-center mb-6 mt-12">
    <h2 class="title title-sm text-content font-bold">Current Reading</h2>
    <%= link_to "See all",
    book_club_book_reads_path(@club),
    class: "text-primary hover:text-accent text-sm font-medium" %>
  </div>

  <% if @current_read %>
    <%= render "shared/book_read_card_link",
    book_read: @current_read,
    club: @club,
    show_club_name: false %>
  <% else %>
    <div
      class="
        bg-surface rounded-lg shadow-sm p-8 text-center border border-dashed
        border-border
      ">
      <svg
        class="mx-auto h-12 w-12 text-content-muted mb-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      <h3 class="text-lg font-medium text-content mb-1">No active reading session</h3>
      <p class="text-content-subtle mb-4">The club admin hasn't selected a book to read yet.</p>
      <% if user_signed_in? && @club.owner == current_user %>
        <%= link_to "Start a New Read",
        new_book_club_book_read_path(@club),
        class:
          "inline-flex items-center justify-center bg-background text-primary hover:bg-background px-6 py-2.5 rounded-md text-sm font-medium transition-colors" %>
      <% end %>
    </div>
  <% end %>
</div>

<%# Swapped by the join/leave/request turbo streams. The container exists only on this page, so stream updates are no-ops on carousels where the replaced card already carries its own dialog - no duplicate IDs. %>
<% if user_signed_in? && @club.is_private %>
  <div id="apply_dialog_container">
    <% unless @club.has_member?(current_user) || @club.pending_request_from?(current_user) %>
      <%= render "book_clubs/apply_dialog", club: @club %>
    <% end %>
  </div>
<% end %>

<% if can_see_private %>
  <% current_user_is_admin =
    @club.book_club_members.find_by(user: current_user)&.admin? %>
  <% current_user_is_owner = @club.owner == current_user %>

  <%= render layout: "shared/dialog",
    locals: {
      id: "members_dialog",
      title: "Club Members (<span data-members-count>#{@club.members.size}</span>)".html_safe,
      box_class: "bg-surface border border-border shadow-xl rounded-2xl max-w-2xl p-6 relative"
    } do %>
    <div id="pending_requests_section">
      <% if current_user_is_owner && @club.pending_membership_requests.any? %>
        <div class="mb-6 border-b border-border pb-6">
          <h4 class="text-sm font-semibold text-content mb-4">Pending Join Requests (<span data-pending-requests-count><%= @club.pending_membership_requests.count %></span>)</h4>
          <div id="pending_requests_list" class="space-y-3">
            <% @club.pending_membership_requests.each do |request| %>
              <div id="<%= dom_id(request) %>" class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <%= render "shared/avatar",
                  user: request.user,
                  classes:
                    "w-8 h-8 bg-blue-600 text-white text-xs font-semibold ring-2 ring-white" %>
                  <span class="text-sm text-content"><%= request.user %></span>
                </div>
                <div class="flex gap-2">
                  <%= button_to "Approve",
                  approve_book_club_membership_request_path(@club, request),
                  method: :patch,
                  form: {
                    data: {
                      turbo_frame: "_top",
                    },
                  },
                  class: "btn btn-primary btn-sm" %>
                  <%= render "components/button",
                  label: "Reject",
                  type: "link",
                  url: reject_book_club_membership_request_path(@club, request),
                  variant: "negative",
                  size: "sm",
                  full_width: false,
                  data: {
                    turbo_submits_with: "Rejecting...",
                    turbo_method: :patch,
                  } %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <% body_content = capture do %>
      <% @club.book_club_members.includes(:user).order(role: :desc, created_at: :asc).each_with_index do |membership, row_idx| %>
        <%= render "book_club_members/member_row",
        membership: membership,
        club: @club,
        is_last: row_idx == @club.book_club_members.size - 1,
        current_user_is_admin: current_user_is_admin %>
      <% end %>
    <% end %>

    <% columns = %w[Member Role Joined] %>
    <% columns << "Actions" if current_user_is_admin %>

    <%= render "shared/table/table",
    columns: columns,
    body_content: body_content,
    hoverable: true,
    sticky_header: false,
    bordered: false,
    container: false,
    tbody_id: "members_tbody" %>
  <% end %>
<% end %>
