<%#
  Past Reads tab panel.
  Locals:
    - club: BookClub
    - past_reads: ActiveRecord::Relation<BookRead>
%>
<section data-club-tabs-target="panel" data-tab="past" hidden class="pt-5">
  <% if past_reads.any? %>
    <div class="space-y-4">
      <% past_reads.each do |read| %>
        <% attendees = read.book_read_rsvps.select(&:going?).map(&:user) %>
        <% discussions_count = read.discussion_questions.size %>
        <article class="relative rounded-3xl border border-border bg-surface p-4 shadow-card">
          <div class="flex gap-4">
            <div class="w-24 shrink-0 self-stretch">
              <figure
                class="
                  relative flex h-full min-h-36 w-full items-center justify-center overflow-hidden
                  rounded-xl border border-border bg-background text-content-muted
                ">
                <% if read.book&.cover_image.present? %>
                  <img
                    src="<%= read.book.cover_image %>"
                    alt="<%= read.book.title %>"
                    loading="lazy"
                    class="absolute inset-0 h-full w-full object-cover">
                <% else %>
                  <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                <% end %>
              </figure>
            </div>

            <div class="flex min-w-0 flex-1 flex-col">
              <h3 class="line-clamp-2 text-base font-bold leading-snug text-content">
                <%= read.book&.title || t("new_reading_session", default: "New Reading Session") %>
              </h3>
              <% if read.book.present? %>
                <p class="mt-0.5 truncate text-xs text-content-subtle">
                  <%= t("by_author", author: read.book.author.presence || t("unknown_author", default: "Unknown Author")) %>
                </p>
              <% end %>

              <div class="mt-2.5 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-content-subtle">
                <span class="inline-flex items-center gap-1.5">
                  <svg class="h-3.5 w-3.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <rect x="3" y="5" width="18" height="16" rx="3" stroke="currentColor" stroke-width="1.7" />
                    <path d="M3 9h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                  </svg>
                  <span class="truncate"><%= read.meetup_time&.strftime("%b %d, %Y") %></span>
                </span>

                <span class="inline-flex min-w-0 items-center gap-1.5">
                  <%= render "shared/avatar",
                  user: read.host,
                  classes: "h-5 w-5 bg-primary text-primary-contrast text-[9px] font-semibold ring-1 ring-border" %>
                  <span class="truncate"><%= t("hosted_by", host: read.host.name.presence || read.host.username.presence || "Unknown Host") %></span>
                </span>
              </div>

              <div class="mt-auto pt-3">
                <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-border pt-3">
                  <div class="flex min-w-0 items-center gap-2">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent">
                      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4.255-.949L3 20l1.395-3.72A7.94 7.94 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                      </svg>
                    </span>
                    <span class="text-xs text-content-subtle">
                      <span class="font-semibold text-content"><%= discussions_count %></span>
                      <%= discussions_count == 1 ? "discussion" : "discussions" %>
                    </span>
                  </div>

                  <% if attendees.any? %>
                    <div class="flex items-center gap-2">
                      <%= render "shared/avatar_group",
                      users: attendees,
                      limit: 3,
                      size_classes: "h-5 w-5",
                      text_size: "text-[8px]",
                      container_classes: "" %>
                      <span class="text-xs text-content-subtle">
                        <span class="font-semibold text-content"><%= attendees.size %></span>
                        attended
                      </span>
                    </div>
                  <% else %>
                    <span class="inline-flex items-center gap-1.5 text-xs text-content-muted">
                      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M17 20h5v-1a4 4 0 00-4-4h-1M9 20H4v-1a4 4 0 014-4h1m4-4a4 4 0 11-8 0 4 4 0 018 0zm8 0a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      <span><%= t("no_attendance_recorded", default: "No attendance recorded") %></span>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <%# Stretched link makes the whole card clickable. %>
          <%= link_to book_club_book_read_path(club, read),
            class:
              "absolute inset-0 z-10 rounded-3xl focus:outline-none focus-visible:ring-2 focus-visible:ring-primary",
            aria: {
              label: t("view_reading_session", default: "View reading session"),
            } do %>
            <span class="sr-only"><%= t("view_reading_session", default: "View reading session") %></span>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-3xl border border-dashed border-border p-8 text-center text-sm text-content-subtle">
      <%= t("no_past_reads", default: "No past reads yet.") %>
    </div>
  <% end %>
</section>
