<%#
  Current reading card for the club detail Overview tab.
  Mirrors the Figma highlight card while preserving the private-club gating and
  the existing RSVP turbo-frame wiring.
  Locals:
    - club: BookClub
    - book_read: BookRead
%>
  <% can_see_details = club.private_info_visible_to?(current_user) %>
  <% book = book_read.book %>
  <% poll = book_read.poll %>
  <% going_count = book_read.book_read_rsvps.going.count %>
  <% detail_path = book_club_book_read_path(club, book_read) %>

  <article
    class="
      relative rounded-3xl border border-border bg-surface p-4 shadow-card
    ">
    <div class="flex gap-4">
      <div class="w-28 shrink-0 self-stretch">
        <% if can_see_details && book&.cover_image.present? %>
          <figure
            class="
              relative h-full min-h-42 w-full overflow-hidden rounded-xl border
              border-border bg-background
            ">
            <img
              src="<%= book.cover_image %>"
              alt="<%= book.title %>"
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover">
          </figure>
        <% elsif can_see_details && poll.present? %>
          <figure
            class="
              relative flex h-full min-h-42 w-full flex-col items-center justify-center
              rounded-xl border border-border bg-background p-2 text-center text-accent
            ">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="mb-1 h-8 w-8">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span class="text-[10px] font-bold uppercase tracking-wider"><%= t("poll", default: "Poll") %></span>
          </figure>
        <% elsif can_see_details %>
          <figure
            class="
              relative flex h-full min-h-42 w-full items-center justify-center rounded-xl
              border border-border bg-background text-content-muted
            ">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </figure>
        <% else %>
          <figure
            class="
              relative flex h-full min-h-42 w-full items-center justify-center rounded-xl
              border border-border bg-background text-content-muted
            ">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M16.5 10.5V6.75a4.5 4.5 0 00-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </figure>
        <% end %>
      </div>

      <div class="flex min-w-0 flex-1 flex-col">
        <h2 class="line-clamp-2 text-lg font-bold leading-snug text-content">
          <%= book&.title || (can_see_details ? poll&.text : nil) ||
            t("new_reading_session", default: "New Reading Session") %>
        </h2>
        <p class="mt-0.5 text-xs text-content-subtle">
          <% if book.present? %>
            <%= t(
              "by_author",
              author:
                book.author.presence || t("unknown_author", default: "Unknown Author"),
            ) %>
          <% elsif poll.present? && can_see_details %>
            <%= t("voting_in_progress", default: "Voting in Progress") %>
          <% end %>
        </p>

        <% if can_see_details %>
          <div class="mt-3 space-y-2">
            <div class="flex items-start gap-2">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor">
                <rect
                  x="3"
                  y="5"
                  width="18"
                  height="16"
                  rx="3"
                  stroke="currentColor"
                  stroke-width="1.7" />
                <path
                  d="M3 9h18M8 3v4M16 3v4"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round" />
              </svg>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-content"><%= book_read.meetup_time&.strftime("%b %d, %Y at %l:%M %p") %></p>
                <p class="text-[11px] text-content-subtle"><%= relative_meetup_hint(book_read.meetup_time) %></p>
              </div>
            </div>
            <div class="flex items-start gap-2">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.7"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.7"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <p class="min-w-0 truncate text-xs font-semibold text-content"><%= book_read.meetup_location.presence || t("tbd", default: "TBD") %></p>
            </div>
          </div>
        <% else %>
          <div
            class="
              mt-3 inline-flex items-center gap-1.5 self-start rounded-lg border border-border
              bg-background px-2.5 py-2 text-xs font-medium text-content
            ">
            <svg
              class="h-3.5 w-3.5 text-content-muted"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.7"
                d="M16.5 10.5V6.75a4.5 4.5 0 00-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
            <span><%= t("members_only", default: "Members only") %></span>
          </div>
        <% end %>

        <% if can_see_details %>
          <div class="mt-auto">
            <%= render "shared/book_read_card_rsvp", club: club, book_read: book_read %>
          </div>
        <% end %>
      </div>
    </div>

    <% if can_see_details && book_read.max_capacity.present? %>
      <% percent = [(going_count.to_f / book_read.max_capacity * 100).round, 100].min %>
      <div class="mt-4 border-t border-border pt-3">
        <div class="flex items-center justify-between text-xs">
          <p class="text-content-subtle">
            <span class="font-bold text-content"><%= going_count %>
              of
              <%= book_read.max_capacity %></span>
            spots reserved
          </p>
          <span class="text-content-muted"><%= t("spots_remaining", count: [book_read.max_capacity - going_count, 0].max) %></span>
        </div>
        <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-background">
          <div class="h-full rounded-full bg-accent" style="width: <%= percent %>%"></div>
        </div>
      </div>
    <% end %>

    <%# Stretched link makes the whole card clickable while the RSVP/edit/share
        controls stay above it via their own z-20 stacking context. %>
    <% if can_see_details %>
      <%= link_to detail_path,
        class:
          "absolute inset-0 z-10 rounded-3xl focus:outline-none focus-visible:ring-2 focus-visible:ring-primary",
        aria: {
          label: t("view_book", default: "View book"),
        } do %>
        <span class="sr-only"><%= t("view_book", default: "View book") %></span>
      <% end %>
    <% end %>
  </article>
