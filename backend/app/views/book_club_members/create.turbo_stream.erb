<%# Replace the card in carousels/lists if present %>
<%= turbo_stream.replace dom_id(@book_club) do %>
  <%= render "book_clubs/card", club: @book_club %>
<% end %>

<%# Replace the show-page action wrapper (not the button itself: the
    replacement is a whole <form>, so swapping the <button> would nest forms).
    Renders the same partial as the initial show render so styling and the
    leave confirmation stay in sync. %>
  <%= turbo_stream.replace "book_club_show_join_button_container" do %>
    <div
      id="book_club_show_join_button_container"
      class="w-full sm:w-auto shrink-0">
      <%= render "book_clubs/show_join_button", club: @book_club %>
    </div>
  <% end %>

  <%# Leaving a private club: restore the apply dialog inside its show-page
    container. The container exists only on the show page, so this is a no-op
    on carousels where the replaced card already carries its own dialog. %>
    <% if @status == "left" && @book_club.is_private %>
      <%= turbo_stream.replace "apply_dialog_container" do %>
        <div id="apply_dialog_container">
          <%= render "book_clubs/apply_dialog", club: @book_club %>
        </div>
      <% end %>
    <% end %>

    <%# Blocked join attempt on a private club: surface the alert as a toast %>
    <% if flash.now[:alert] %>
      <%= turbo_stream.append "toast_triggers" do %>
        <div
          data-controller="flash-toast"
          data-flash-toast-message-value="<%= flash.now[:alert] %>"
          data-flash-toast-type-value="error"></div>
      <% end %>
    <% end %>
